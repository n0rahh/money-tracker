rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'vlad.herasymovychh@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isKind(k) {
      return k == 'expense' || k == 'income';
    }
    function isIsoDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function isIsoMonth(s) {
      return s is string && s.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }
    function validCategory(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.icon is string
        && d.color is string
        && isKind(d.kind)
        && d.order is number
        && d.archived is bool;
    }
    function validTransaction(d) {
      return isKind(d.kind)
        && d.amount is int && d.amount > 0 && d.amount < 100000000000
        && d.categoryId is string && d.categoryId.size() >= 1
        && d.note is string && d.note.size() <= 200
        && isIsoDate(d.date)
        && d.at is timestamp
        && (!('recurringId' in d) || (d.recurringId is string && d.recurringId.size() >= 1 && d.recurringId.size() <= 64))
        && (!('source' in d) || d.source in ['app', 'shortcut', 'import']);
    }
    function validBudget(d) {
      return d.monthly is int && d.monthly > 0 && d.monthly < 100000000000;
    }
    function validRecurring(d) {
      return isKind(d.kind)
        && d.amount is int && d.amount > 0 && d.amount < 100000000000
        && d.categoryId is string && d.categoryId.size() >= 1
        && d.note is string && d.note.size() <= 200
        && d.dayOfMonth is int && d.dayOfMonth >= 1 && d.dayOfMonth <= 31
        && isIsoMonth(d.startMonth)
        && (d.endMonth == null || isIsoMonth(d.endMonth))
        && (d.lastAppliedMonth == null || isIsoMonth(d.lastAppliedMonth));
    }

    match /categories/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validCategory(request.resource.data);
    }
    match /transactions/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validTransaction(request.resource.data);
    }
    match /budgets/{categoryId} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validBudget(request.resource.data);
    }
    match /recurring/{id} {
      allow read, delete: if isOwner();
      // The id becomes the recurringId of the entries a template creates, which validTransaction caps at 64 characters.
      allow create, update: if isOwner() && id.size() <= 64 && validRecurring(request.resource.data);
    }
    match /settings/{id} {
      allow read, write: if isOwner();
    }
  }
}
